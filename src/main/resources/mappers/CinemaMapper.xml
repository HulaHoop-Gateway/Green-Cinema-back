<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ohgiraffers.com.cinemaFranchise.CinemaFranchiseMapper">
    <resultMap id="cinemaFranchiseResultMap" type="com.ohgiraffers.com.cinemaFranchise.CinemaFranchiseDTO">
        <id property="branchNum" column="branch_num"/>
        <result property="branchName" column="branch_name"/>
        <result property="address" column="address"/>
    </resultMap>
    <select id="findAllCinemaFranchises" resultMap="cinemaFranchiseResultMap">
        SELECT
        branch_num,
        branch_name,
        address
        FROM T_CinemaFranchise
        ORDER by branch_num


    </select>
</mapper>