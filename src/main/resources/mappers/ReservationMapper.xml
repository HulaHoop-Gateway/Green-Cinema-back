<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.novacinema.reservation.model.dao.ReservationMapper">
    <resultMap id="reservationResultMap" type="com.novacinema.reservation.model.dto.ReservationDTO">
        <id property="reservationNum" column="reservation_num"/>
        <result property="userCode" column="user_code"/>
        <result property="movieNum" column="movie_num"/>
        <result property="scheduleNum" column="schedule_num"/>
        <result property="seatCode" column="seat_code"/>
        <result property="paymentTime" column="payment_time"/>
        <result property="status" column="status"/>
    </resultMap>
    <select id="selectAllReservation" resultMap="reservationResultMap">
        SELECT
        reservation_num,
        user_code,
        movie_num,
        schedule_num,
        seat_code,
        payment_time,
        status
        FROM T_ReservationInfo;
    </select>
    <select id="selectReservationById" resultMap="reservationResultMap" parameterType="int">
        SELECT
        reservation_num,
        user_code,
        movie_num,
        schedule_num,
        seat_code,
        payment_time,
        status
        FROM T_ReservationInfo
        WHERE reservation_num = #{reservationNum}
    </select>

</mapper>