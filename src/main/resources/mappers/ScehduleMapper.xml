<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.novacinema.schedule.model.dao.ScheduleMapper">
    <resultMap id="scheduleResultMap" type="com.novacinema.schedule.model.dto.ScheduleDTO">
        <id property="scheduleNum" column="schedule_num" />
        <result property="screeningDate" column="screening_date" />
        <result property="startTime" column="start_time" />
    </resultMap>
    <select id="selectAllSchedules" resultMap="scheduleResultMap">
        SELECT
        schedule_num,
        screening_date,
        start_time
        FROM T_Schedule
    </select>

</mapper>
