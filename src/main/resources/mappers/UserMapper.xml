<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.novacinema.user.model.dao.UserMapper">

    <select id="findById" resultType="com.novacinema.user.model.dto.UserDTO">
        SELECT
            user_code AS userCode,
            name,
            id,
            password,
            phone
        FROM t_user
        WHERE id = #{id}
    </select>

</mapper>